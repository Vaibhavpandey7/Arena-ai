# OpenRouter API credentials (required)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# OpenRouter rankings attribution (optional)
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_SITE_NAME=AI Arena

# Upstash Redis / Vercel Storage (optional in dev, auto-injected in production)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# Or legacy KV:
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
