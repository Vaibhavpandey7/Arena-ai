# OpenRouter API credentials (required)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# OpenRouter rankings attribution (optional)
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_SITE_NAME=DIL Intelligence Studio

# Upstash Redis / Vercel Storage (optional in dev, auto-injected in production)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# Or legacy KV:
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# Pinecone Cloud Vector DB (optional - enables scalable cloud vector search for regulatory library)
# Create a free index at https://app.pinecone.io (1536 dimensions, metric: cosine)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=insurance-regulations
